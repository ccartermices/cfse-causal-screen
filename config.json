        "sae_feature_data_dir": "./output/phase3/sae_feature_data/{model_name}",
        "sae_ao_dir": "./output/phase3/sae_ao/{model_name}",
        "sae_guided_dir": "./output/phase3/sae_guided/{model_name}",
        "visual_processing_dir": "./output/phase4/visual_processing/{model_name}",
        "cross_modal_dir": "./output/phase4/cross_modal/{model_name}",
        "eval_dir": "./output/phase5/eval_results/{model_name}",
        "comparison_dir": "./output/phase5/comparisons/{model_name}",
        "ablation_dir": "./output/phase5/ablation/{model_name}"
    }
