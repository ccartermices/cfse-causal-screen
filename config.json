    "phase1_data": {
        "text_datasets": {
            "alpaca_cleaned": {
                "path": "yahma/alpaca-cleaned",
                "samples": 1000,
                "type": "hf_dataset"
            },
            "c4_en": {
                "path": "allenai/c4",
                "subset": "en",
                "samples": 1500,
                "type": "hf_dataset"
            },
            "wikipedia_en": {
                "path": "wikimedia/wikipedia",
                "subset": "20231101.en",
                "samples": 1000,
                "type": "hf_dataset"
            },
            "fineweb": {
                "path": "HuggingFaceFW/fineweb",
                "subset": "sample-10BT",
                "samples": 1000,
                "type": "hf_dataset"
            },
            "cosmopedia_openstax": {
                "path": "HuggingFaceTB/cosmopedia",
                "subset": "openstax",
                "samples": 1000,
                "type": "hf_dataset"
            }
        },
        "multimodal_datasets": {
            "coco_caption": {
                "path": "HuggingFaceM4/COCO",
                "samples": 10000,
                "type": "hf_dataset",
                "task": "image_caption",
                "note": "COCO 2017, ~25GB图片+标注, 可调整samples控制下载量"
            },
            "sharegpt4v": {
                "path": "Lin-Chen/ShareGPT4V",
                "subset": "ShareGPT4V",
                "samples": 10000,
                "type": "hf_dataset",
                "task": "image_description",
                "note": "ShareGPT4V, ~13GB图片, 从HF直接下载含图片"
            }
        },
        "activation_collection": {
            "text_samples": 3000,
            "visual_samples": 1000,
            "sample_ratio": 1.0,
            "max_length": 256,
            "last_n_tokens": 3
        }
    },
    "phase2_sae": {
        "text_sae": {
            "learning_rate": 5e-4,
            "batch_size": 2048,
            "num_epochs": 30,
            "weight_decay": 0.01,
            "l1_lambda": 1e-4,
            "warmup_epochs": 3,
            "resample_dead_every": 5,
            "decoder_norm": true
        },
        "vision_sae": {
            "learning_rate": 5e-4,
            "batch_size": 2048,
            "num_epochs": 30,
            "weight_decay": 0.01,
            "l1_lambda": 1e-4,
            "warmup_epochs": 3,
            "resample_dead_every": 5,
            "decoder_norm": true
        },
        "unified_vl_sae": {
            "enabled": true,
            "learning_rate": 2e-4,
            "batch_size": 1024,
            "num_epochs": 30,
            "weight_decay": 0.01,
            "l1_lambda": 1e-4,
            "warmup_epochs": 3,
            "resample_dead_every": 5,
            "decoder_norm": true
        }
    },
    "phase3_sae_ao": {
        "feature_interpretation": {
            "top_k_features": null,
            "samples_per_feature": 10,
            "use_api": false,
            "api_type": "minimax",
            "api_model": "MiniMax-M2.7",
            "api_env_var": "MINIMAX_API_KEY",
            "api_key_file": "minimax_api_key.txt",
            "api_workers": 16,
            "api_batch_size": 16
        },
        "sae_ao_training": {
            "lora_r": 16,
            "lora_alpha": 32,
            "lora_dropout": 0.05,
            "learning_rate": 2e-5,
            "per_device_train_batch_size": 1,
            "gradient_accumulation_steps": 8,
            "num_train_epochs": 3,
            "warmup_ratio": 0.1,
            "logging_steps": 10,
            "save_steps": 200,
            "max_length": 384,
            "num_act_tokens": 5
        },
        "sae_guided_injection": {
            "enabled": true,
            "injection_scale": 0.5,
            "feature_selection_threshold": 0.1
        }
    },
    "phase4_multimodal": {
        "visual_processing": {
            "pooling_method": "cls",
            "projection_dim": 2048
        },
        "cross_modal_training": {
            "alignment_loss_weight": 0.3,
            "num_epochs": 2
        }
    },
    "phase5_evaluation": {
        "tasks": ["feature_retrieval", "generation_quality"],
        "num_samples": 50,
        "baselines": {
            "original_ao": true,
            "patchscopes": true,
            "sae_direct": true,
            "linear_probe": true,
            "sae_feature_retrieval": true
        },
        "ablation": {
            "without_sae": true,
            "without_multimodal": true,
            "without_feature_selection": true,
            "without_cross_modal": true
        }
    },
    "paths": {
        "data_dir": "./data",
        "image_dir": "./data/images",
        "text_activation_dir": "./output/phase1/text_activations/{model_name}",
        "visual_activation_dir": "./output/phase1/visual_activations/{model_name}",
        "text_sae_dir": "./output/phase2/text_sae/{model_name}",
